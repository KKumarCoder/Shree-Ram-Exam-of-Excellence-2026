NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/shree_olympiad
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
OTP_PEPPER=REPLACE_WITH_DIFFERENT_32_RANDOM_CHARACTERS


FRONTEND_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD

# Generic JSON SMS provider (update payload in services/notifications.js to match your provider)
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER=
SMS_TEMPLATE_ID=
SMS_AUTH_HEADER=Authorization
SMS_AUTH_PREFIX=Bearer

# Optional email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=


# PAYMENT_MODE=manual or razorpay (admin can override in settings)
PAYMENT_MODE=manual
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Official school payee details configured in admin settings

# Official Twilio Verify; backend only. Use the Shree Ram Public School service.
SMS_PROVIDER=twilio
OTP_DELIVERY_MODE=sms
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_CHALLENGE_TTL_SECONDS=600
OTP_AUTHORIZATION_TTL_SECONDS=1800
OTP_MAX_VERIFICATION_ATTEMPTS=5
OTP_MOBILE_HOURLY_LIMIT=5
OTP_DRAFT_HOURLY_LIMIT=5
OTP_IP_LIMIT=30
TRUST_PROXY_HOPS=0
OTP_GLOBAL_HOURLY_LIMIT=100
