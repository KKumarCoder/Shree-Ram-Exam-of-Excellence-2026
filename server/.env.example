NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/shree_olympiad
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
OTP_HASH_SECRET=
# Legacy OTP_PEPPER remains supported if OTP_HASH_SECRET is unset.


FRONTEND_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD

# Required SMTP email: OTP, admit card and receipt delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# PAYMENT_MODE=manual or razorpay (admin can override in settings)
PAYMENT_MODE=manual
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Official school payee details configured in admin settings

# Email is the only OTP delivery channel.
OTP_DELIVERY_MODE=email
# OTP security: defaults apply unless overridden. Never bypasses verification.
OTP_ENABLED=true
# Only NODE_ENV=development may print a masked [DEV OTP] and skip email delivery.
OTP_DEV_MODE=false
OTP_RESEND_SECONDS=60
OTP_EXPIRY_MINUTES=5
OTP_AUTHORIZATION_TTL_SECONDS=1800
OTP_MAX_ATTEMPTS=5
OTP_EMAIL_HOURLY_LIMIT=5
OTP_DRAFT_HOURLY_LIMIT=5
OTP_IP_LIMIT=30
TRUST_PROXY_HOPS=0
OTP_GLOBAL_HOURLY_LIMIT=100

# Legacy OTP_RESEND_COOLDOWN_SECONDS, OTP_CHALLENGE_TTL_SECONDS and
# OTP_MAX_VERIFICATION_ATTEMPTS are supported when their newer equivalents are unset.

# Required: protected Cloudinary storage (backend only; never VITE_*).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
